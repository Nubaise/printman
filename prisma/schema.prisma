generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrintType {
  BW
  COLOR
}

enum PrinterReliability {
  HIGH
  LOW
}

enum PrinterStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Printer {
  id            String            @id
  name          String
  type          PrintType
  speed         Int
  reliability   PrinterReliability
  status        PrinterStatus     @default(ACTIVE)
  singleSided   Boolean           @default(true) @map("single_sided")
  doubleSided   Boolean           @default(false) @map("double_sided")
  color         Boolean           @default(false)

  bookings      Booking[]

  @@map("printers")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  rollNumber      String        @map("roll_number")
  printerId       String        @map("printer_id")
  bookingDate     DateTime      @map("booking_date") @db.Date
  startTime       DateTime      @map("start_time") @db.Time(0)
  endTime         DateTime      @map("end_time") @db.Time(0)
  pages           Int
  copies          Int
  type            PrintType
  doubleSided     Boolean       @default(false) @map("double_sided")
  binding         Boolean       @default(false)
  durationMinutes Int           @map("duration_minutes")
  price           Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(CONFIRMED)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  printer         Printer       @relation(fields: [printerId], references: [id])

  @@index([bookingDate, printerId])
  @@map("bookings")
}
